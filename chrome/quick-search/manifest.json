{
    "name": "__MSG_extTitle__",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
      "tabs",
      "contextMenus",
      "storage"
    ],
    "icons": {
      "16": "images/search_16.png",
      "32": "images/search_32.png",
      "128": "images/search_128.png"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "css/menu_theme.css",
          "images/icons.png"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "action": {
        "default_popup": "html/popup.html",
        "default_icon": "images/search_32.png"
    },
    "options_page": "html/popup.html",
    "content_scripts": [
      {
        "matches": [
          "http://*/*",
          "https://*/*"
        ],
        "js": [
          "js/content.js"
        ],
        "all_frames": true
      }
    ],
    "background": {
      "service_worker": "js/background.js",
      "type": "module"
    }
  }